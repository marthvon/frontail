{
  "name": "@marthvon/frontail",
  "version": "0.7.0",
  "description": "Tailwind Extension",
  "private": false,
  "author": "marthvon <mamertvonn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marthvon/frontail.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "base/*.css",
    "components/*.css",
    "utilities/*.css",
    "theme/*.css",
    "./plugin.js",
    "types/index.d.ts"
  ],
  "exports": {
    ".": {
      "require": "./plugin.js",
      "types": "./types/index.d.ts"
    },
    "./plugin": {
      "require": "./plugin.js",
      "types": "./types/index.d.ts"
    },
    "./base/*.css": {
      "default": "./base/*.css"
    },
    "./components/*.css": {
      "default": "./components/*.css"
    },
    "./theme/*.css": {
      "default": "./theme/*.css"
    },
    "./utilities/*.css": {
      "default": "./utilities/*.css"
    }
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "types": "./types/index.d.ts",
  "type": "commonjs",
  "keywords": [
    "Tailwind",
    "CSS",
    "UI",
    "Utility",
    "Dashboard",
    "Layout",
    "Components",
    "Application"
  ]
}
